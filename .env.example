# 서버 주소와 서비스 데이터베이스를 필요할 때 분리해 실행할 수 있습니다.
HOST=127.0.0.1
PORT=8788
SAI_PORT=
SAI_DB_PATH=.data/sai.sqlite
# 필요하면 로컬 Demo 세션 저장소도 별도 디렉터리로 분리합니다.
SAI_DEMO_DIR=

# 웹 빌드는 빈 값이면 동일 origin의 /api/app을 사용합니다.
EXPO_PUBLIC_API_URL=

# 관심사 문장 추출은 OpenAI 또는 로컬 Ollama 중 하나를 설정합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_URL=
OLLAMA_MODEL=qwen3:1.7b

# YouTube 선택 채널 관심사 추출과 연결 주제 후보 생성용 서버 비밀값.
# 연결 주제는 Qwen3가 실제 공유 관심사로 재검증합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Vercel과 로컬 Node에서 Qwen3 모델을 직접 실행합니다.
# Vercel /api/bridge-validate 인증. 생략하면 GROUP_SOLVER_TOKEN 사용.
BRIDGE_VALIDATOR_TOKEN=

# Google Cloud의 YouTube Data API v3 및 OAuth 웹 클라이언트 설정입니다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8788/api/app?action=youtubeCallback

# 로컬 CP-SAT은 프로젝트 전용 .data/solver-env를 기본 사용합니다.
SAI_SOLVER_PYTHON=
# Demo API도 같은 Python 환경을 사용하도록 필요할 때 지정합니다.
SAI_PYTHON=

# Vercel CP-SAT 주소를 직접 지정할 때만 설정합니다. 기본은 같은 도메인의 /api/solver입니다.
GROUP_SOLVER_URL=
GROUP_SOLVER_TOKEN=
# 선택적인 로컬 CP-SAT HTTP 서비스(npm run solver:serve)의 바인딩입니다.
GROUP_SOLVER_HOST=127.0.0.1
GROUP_SOLVER_PORT=8790

# Vercel 계정 API의 영구 SQLite 저장소 (서버 비밀값; EXPO_PUBLIC 사용 금지).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel에서는 원격 CP-SAT 주소 생략 시 접속한 도메인의 /api/solver를 사용합니다.
# GROUP_SOLVER_TOKEN은 Node API와 Python 함수에 동일한 32자 이상 임의값입니다.
# 별도 BRIDGE_VALIDATOR_TOKEN이 없으면 /api/bridge-validate 인증에도 사용합니다.

# LinkedIn 링크에서 관심사 후보를 추출합니다. 비밀 키는 서버에서만 사용합니다.
BRIGHTDATA_API_KEY=
BRIGHTDATA_LINKEDIN_DATASET_ID=gd_l1viktl72bvl7bjuj0
LINKEDIN_GEMINI_MODEL=gemini-3.5-flash-lite
